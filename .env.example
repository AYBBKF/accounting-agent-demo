# Copier en .env et remplir. Ne jamais committer le .env reel.

TELEGRAM_BOT_TOKEN=
# Identifiants Telegram autorises, separes par des virgules (liste blanche stricte)
ALLOWED_TELEGRAM_USER_IDS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_STORE=false
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_REASONING_EFFORT=none

DB_PATH=/app/data/demo.db
DEFAULT_VAT_RATE=20.0
VAT_RATES_AVAILABLE=0,7,10,20
RECONCILIATION_WINDOW_DAYS=5
RECONCILIATION_AMOUNT_TOLERANCE=0.01

# --- Google Sheets (optionnel, via la connexion Composio deja active) ---
# Aucun compte de service Google, aucune cle JSON : la synchronisation
# passe par la connexion Google Sheets OAuth deja active dans Composio.
# Ne jamais committer ces valeurs.
COMPOSIO_API_KEY=
# Fournir COMPOSIO_USER_ID OU COMPOSIO_CONNECTED_ACCOUNT_ID (un seul suffit).
COMPOSIO_USER_ID=
COMPOSIO_CONNECTED_ACCOUNT_ID=
# ID du classeur Google Sheets cible (trouvable dans son URL). Si absent,
# la synchronisation Sheets est desactivee automatiquement (aucun crash).
GOOGLE_SHEET_ID=

# --- Connexions Google multi-clients (/connect, /status) ---
# Chaque client Telegram connecte SES PROPRES comptes Gmail/Sheets/Drive/
# Calendar via un Connect Link individuel (isole par user_id="telegram_<chat_id>").
# Les 4 valeurs ci-dessous ont des defauts codes dans app/config.py (auth configs
# du projet Composio du bot) ; ne les surcharger que si le projet Composio change.
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_GOOGLESHEETS=
COMPOSIO_AUTH_CONFIG_GOOGLEDRIVE=
COMPOSIO_AUTH_CONFIG_GOOGLECALENDAR=
