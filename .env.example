# Copier en .env et remplir. Ne jamais committer le .env reel.

TELEGRAM_BOT_TOKEN=
# Identifiants Telegram autorises, separes par des virgules (liste blanche stricte)
ALLOWED_TELEGRAM_USER_IDS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_STORE=false
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_REASONING_EFFORT=none

DB_PATH=/app/data/demo.db
DEFAULT_VAT_RATE=20.0
VAT_RATES_AVAILABLE=0,7,10,20
RECONCILIATION_WINDOW_DAYS=5
RECONCILIATION_AMOUNT_TOLERANCE=0.01

# --- Google Sheets (optionnel) ---
# Compte de service Google Cloud dedie (JSON complet en une ligne, OU chemin
# vers un fichier de cle monte dans le conteneur). Ne jamais committer la cle.
# Le Sheet cible doit etre partage avec l'adresse e-mail du compte de service
# en tant qu'Editeur. Si aucune des deux valeurs n'est fournie, la
# synchronisation Sheets est desactivee automatiquement (aucun crash).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
