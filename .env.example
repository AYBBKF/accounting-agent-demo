# Copier en .env et remplir. Ne jamais committer le .env reel.

TELEGRAM_BOT_TOKEN=
# Identifiants Telegram autorises, separes par des virgules (liste blanche stricte)
ALLOWED_TELEGRAM_USER_IDS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_STORE=false
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_REASONING_EFFORT=medium

DB_PATH=/app/data/demo.db
DEFAULT_VAT_RATE=20.0
VAT_RATES_AVAILABLE=0,7,10,20
RECONCILIATION_WINDOW_DAYS=5
RECONCILIATION_AMOUNT_TOLERANCE=0.01
